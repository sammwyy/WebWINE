#include <windows.h>

#define IDD_MAIN_DIALOG 101
#define IDC_HELLO_TEXT 1001

IDD_MAIN_DIALOG DIALOGEX 0, 0, 220, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "12_resource_dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Loading...", IDC_HELLO_TEXT, 12, 12, 196, 16
    DEFPUSHBUTTON "OK", IDOK, 60, 56, 45, 14
    PUSHBUTTON "Cancel", IDCANCEL, 116, 56, 45, 14
END
